<UserControl x:Class="NetLane.UI.Controls.ExecutableIcon"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="32" Height="32" Focusable="False" IsHitTestVisible="False">
    <Grid>
        <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="7">
            <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers>
                <DataTrigger Binding="{Binding IconSource, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
            </Style.Triggers></Style></Border.Style>
            <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <Image Source="{Binding IconSource, RelativeSource={RelativeSource AncestorType=UserControl}}" Stretch="Uniform" />
    </Grid>
</UserControl>
