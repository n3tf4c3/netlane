<UserControl x:Class="NetLane.UI.Controls.ConnectionQualityIndicator"
             x:Name="IndicatorRoot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="66" Height="62" Focusable="True" IsTabStop="True"
             AutomationProperties.Name="{Binding Label}" AutomationProperties.HelpText="{Binding ToolTip}"
             ToolTipService.InitialShowDelay="150" ToolTipService.ShowDuration="30000">
    <UserControl.Resources>
        <Style x:Key="QualityGlyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Rating}" Value="Good"><Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding Rating}" Value="Fair"><Setter Property="Foreground" Value="{DynamicResource WarningBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding Rating}" Value="Poor"><Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding Rating}" Value="NoResponse"><Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" /></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="QualityIconBorder" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Rating}" Value="Good"><Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding Rating}" Value="Fair"><Setter Property="BorderBrush" Value="{DynamicResource WarningBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding Rating}" Value="Poor"><Setter Property="BorderBrush" Value="{DynamicResource ErrorBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding Rating}" Value="NoResponse"><Setter Property="BorderBrush" Value="{DynamicResource ErrorBrush}" /></DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <UserControl.ToolTip>
        <ToolTip Padding="10,8" BorderThickness="1" Background="{DynamicResource QualityBubbleBrush}" BorderBrush="{DynamicResource QualityBubbleLineBrush}" Foreground="{DynamicResource QualityBubbleTextBrush}">
            <ToolTip.Template><ControlTemplate TargetType="ToolTip">
                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                    <ContentPresenter />
                </Border>
            </ControlTemplate></ToolTip.Template>
            <TextBlock Text="{Binding ToolTip}" Foreground="{DynamicResource QualityBubbleTextBrush}" FontSize="11" LineHeight="16" MaxWidth="320" TextWrapping="Wrap" />
        </ToolTip>
    </UserControl.ToolTip>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="29" /><RowDefinition Height="5" /><RowDefinition Height="28" /></Grid.RowDefinitions>
        <Border x:Name="LatencyBubble" Background="{DynamicResource QualityBubbleBrush}" BorderBrush="{DynamicResource QualityBubbleLineBrush}" BorderThickness="1" CornerRadius="8" Padding="7,3" HorizontalAlignment="Center" MinWidth="54">
            <TextBlock Text="{Binding LatencyLabel}" Foreground="{DynamicResource QualityBubbleTextBrush}" FontSize="12" FontWeight="SemiBold" TextAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <Path Grid.Row="1" Data="M 0,0 L 8,0 L 4,4 Z" Fill="{DynamicResource QualityBubbleBrush}" Width="8" Height="5" HorizontalAlignment="Center" Margin="0,-1,0,0" />
        <Border Grid.Row="2" Style="{StaticResource QualityIconBorder}" Width="27" Height="27" CornerRadius="7" BorderThickness="1" Background="{DynamicResource SubtleBrush}" HorizontalAlignment="Center">
            <TextBlock Text="{Binding IconGlyph, ElementName=IndicatorRoot}" Style="{StaticResource QualityGlyph}" FontSize="17" />
        </Border>
    </Grid>
</UserControl>
